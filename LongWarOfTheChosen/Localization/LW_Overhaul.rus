[ProtectRegionMid X2LWAlienActivityTemplate]
ActivityName="ProtectRegion2Activity"
ActivityObjectives[0]="Освобождение: спасите перебежчика"

+MissionDescriptions=(MissionFamily="Extract_LW", Description="Мы можем эвакуировать перебежчика из АДВЕНТА, располагающего важными сведениями об уязвимостях пришельцев в этом регионе.", MissionIndex=0)
+MissionDescriptions=(MissionFamily="Rescue_LW", Description="Мы узнали о стороннике Сопротивления, который располагает важными сведениями об уязвимостях пришельцев в этом регионе.", MissionIndex=0)

[ProtectRegion X2LWAlienActivityTemplate]
ActivityName="ProtectRegion3Activity"
ActivityObjectives[0]="Освобождение: помешайте действиям АДВЕНТА"
ActivityObjectives[1]="Освобождение: уничтожьте сетевую вышку"
ActivityObjectives[2]="Освобождение: атакуйте базу АДВЕНТА"

+MissionDescriptions=(MissionFamily="DestroyObject_LW", Description="Мы обнаружили устройство АДВЕНТА, которое глушит связь Сопротивления. Его необходимо уничтожить.", MissionIndex=0)
+MissionDescriptions=(MissionFamily="Neutralize_LW", Description="Наши усилия помогли обнаружить чиновника АДВЕНТА, который руководит операциями противника в этом регионе. Его необходимо устранить.", MissionIndex=0)

+MissionDescriptions=(MissionFamily="AssaultNetworkTower_LW", Description="Наши победы в этом регионе множатся. Пора уничтожить узел связи противника в региональной столице.", MissionIndex=1)

+MissionDescriptions=(MissionFamily="AssaultAlienBase_LW", Description="Операции АДВЕНТА в этом регионе дезорганизованы. Мы можем атаковать местный военный штаб и освободить регион от их контроля.", MissionIndex=2)

