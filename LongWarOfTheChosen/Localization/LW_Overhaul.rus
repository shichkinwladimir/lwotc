[UISL_Shell_LWoTCVersion]
strMessage_Title = "Long War of the Chosen"
strMessage_Header = "Long War Of The Chosen обновлён!
strMessage_Body="Вышла версия 1.2.3. Это не полноценное обновление, но в него вошли:<ul><li>Балансировка ИСКР: новая броня, изменённое дерево способностей и возвращение брони с поглощением урона; раненых ИСКР больше нельзя отправлять на задания</li><li>Множество новых карт и элементов карт, которые заставят вас выйти из зоны комфорта</li><li>Улучшенный интерфейс сведений в управлении аванпостом</li><li>Исправления вылетов и других ошибок, включая исчезновение эвакуации, серьёзный вылет в Linux и многое другое</li></ul><br/>Подробности смотрите в документе Google, ссылка на который есть в заметках обновления Steam, или на сервере Discord LWoTC! <br>Примечание: изменения совместимы с текущей кампанией. Для обновлённого дерева способностей СПАРКа можно использовать команду RespecSelectedSoldier."
strDismiss_Button = "OK"

[UISL_Shell_BetaPatchNotes]
strMessage_Title = "Long War of the Chosen"
strMessage_Header = "Последние изменения бета-версии:"
strMessage_Body="Вышла версия 1.2.3. Это не полноценное обновление, но в него вошли:<ul><li>Балансировка ИСКР: новая броня, изменённое дерево способностей и возвращение брони с поглощением урона; раненых ИСКР больше нельзя отправлять на задания</li><li>Множество новых карт и элементов карт, которые заставят вас выйти из зоны комфорта</li><li>Улучшенный интерфейс сведений в управлении аванпостом</li><li>Исправления вылетов и других ошибок, включая исчезновение эвакуации, серьёзный вылет в Linux и многое другое</li></ul><br/>Подробности смотрите в документе Google, ссылка на который есть в заметках обновления Steam, или на сервере Discord LWoTC! <br>Примечание: изменения совместимы с текущей кампанией. Для обновлённого дерева способностей СПАРКа можно использовать команду RespecSelectedSoldier."
strDismiss_Button = "OK"

