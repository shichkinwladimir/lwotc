[AirController X2AbilityTemplate]
LocFriendlyName="Диспетчер"
LocLongDescription="\"Рейнджер\" будет прибывать по запросу эвакуации на <Ability:AIR_CONTROLLER_EVAC_TURN_REDUCTION/> ход. быстрее."
